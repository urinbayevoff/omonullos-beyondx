# Galaxy S10 5G: Samsung's Shannon modem interfaces (S5000AP LTE, S5100 5G on
# PCIe; G977N kernel modem_v1_dual, GPL) as one module for mainline, on the
# ztOS S9 port (modem/zrn-modem): the mailbox (mcu_ipc), the shared memory
# (shm_ipc) and the modems' boot, power, framing and io devices. The S5100
# needs pcie-exynos9820-ch1.ko (kernel/beyondx/pcie1) loaded first. Added for
# OmonullOS, October 2026.
obj-m += zrn-modem.o
# /dev/drb, without which the RIL's SINR thread spins (zrn_drb.c)
obj-m += zrn_drb.o
zrn-modem-y := mcu_ipc.o shm_ipc.o \
	modem_main.o modem_variation.o modem_io_device.o modem_utils.o modem_dump.o \
	link_device_shmem.o link_device_memory_snapshot.o link_device_memory_flow_control.o \
	link_device_memory_debug.o link_device_memory_sbd.o modem_notifier.o \
	modem_ctrl_s5000ap.o zrn_cp_pmu.o zrn_board.o zrn_overlay_blob.o \
	link_device_pcie.o s5100_pcie.o modem_ctrl_s5100.o zrn_s5100_gpio.o zrn_spi_boot.o
ccflags-y += -I$(src) -I$(src)/include -I$(src)/zinc -include $(src)/zrn_compat.h \
	-DCONFIG_OPTION_REGION=\"KOR\" \
	-Wno-unused-function -Wno-unused-variable -Wno-missing-prototypes \
	-Wno-declaration-after-statement -Wno-missing-declarations

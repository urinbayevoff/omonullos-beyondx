# What .github/workflows/build-image-beyondx.yml does on a push to
# ci-image-beyondx (docs/s10-5g/IMAGE-BUILD.md, step 3).
#   MODE=full    job 1 (BOOT + kernel-side files) then job 2 (root image)
#   MODE=rootfs  job 2 only, with --allow-missing: a dry run of the root
#                image without the kernel job (no Wi-Fi, sound, modem in it)
# The BOOT flags and name come from kernel/beyondx/ci-build.env.
MODE=full

# 0.2.7: user space (ztMETRO, ztsettings, zsleepd + zgpio, ztouch, zcell) and
# four modules: the sound driver (stereo with the earpiece protection), the
# touchscreen with ear detection (ztouch binds it) and brcmfmac with relaxed
# ordering off, pcie-exynos9820 with relink (zwlan-guard). KERNEL_FILES is cumulative (see 0.2.3.env).
KERNEL_FILES="usr/local/lib/zboot/tools/zrn-system-sleep-bx.ko usr/local/lib/zboot/tools/snd-zrn-abox-bx.ko usr/local/lib/zboot/tools/zrn-s6sy761.ko usr/lib/modules/7.1.0-zboot/extra/brcmfmac.ko usr/lib/modules/7.1.0-zboot/extra/pcie-exynos9820.ko"

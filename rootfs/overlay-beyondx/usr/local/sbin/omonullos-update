#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""omonullos-update: OmonullOS's own updates (run as root, by its services).

Arch's packages are ztos-update's business (pacman). This one updates what
OmonullOS itself puts on the phone and pacman does not know about: ztMETRO,
the apps, the z* helpers, the scripts and the overlay files.

    omonullos-update check [--quiet]   is there a newer signed release?
    omonullos-update apply             download, verify and install it
    omonullos-update rollback          put back what the last update replaced
    omonullos-update status            print the state (for people)
    omonullos-update boot              (early at boot) the trial after a module update
    omonullos-update boot-ok           (3 min after boot) the trial passed

A release has three files: manifest.json (version, what is new, every file with
its sha256), manifest.json.sig (ed25519 over the exact manifest bytes, made with
a key that lives only with the owner, never on GitHub) and the package (a
tar.zst of the files). Nothing is used before the signature is good, and every
file is checked against the manifest before it is installed.

It writes only below ALLOWED. User space (stage 1, updater 1): usr/local and
the overlay's /etc. Kernel modules (updater 2): our out-of-tree modules in
usr/local/lib/zboot and usr/lib/modules/RELEASE/extra, and only when the
manifest's "kernel" (release, vermagic, config_digest of the kernel config) is
the running kernel's (/proc/config.gz) and every .ko's vermagic matches: modules
are never installed for another kernel. After a module update the next boots
are a trial: if the phone does not stay up 3 minutes twice, the third boot
puts the old files back before any of our modules load. BOOT and firmware
are never touched; a manifest that needs a newer updater says so with
"min_updater" and is refused ("update the updater first").

State for the Updates app:
    /run/omonullos-update/status.json   {"state": ..., "k": .., "n": .., "msg": ..}
    /var/lib/omonullos-update/available.json   the verified manifest on offer
    /var/lib/omonullos-update/installed.json   the manifest now installed
    /var/lib/omonullos-update/backup/<version>/ what the last update replaced

Added for OmonullOS, November 2026.
"""
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.request

UPDATER_VERSION = 2        # what this updater can install (manifest "min_updater")
DEVICE = "beyondx"

ROOT = os.environ.get("OMONULLOS_UPDATE_ROOT", "/").rstrip("/") or "/"
CONF = os.environ.get("OMONULLOS_UPDATE_CONF", "/etc/omonullos-update.conf")
RUN = os.environ.get("OMONULLOS_UPDATE_RUN", "/run/omonullos-update")
VAR = os.environ.get("OMONULLOS_UPDATE_VAR", "/var/lib/omonullos-update")
LOG = os.environ.get("OMONULLOS_UPDATE_LOG", "/var/log/omonullos-update.log")
KEYS = "/usr/local/share/omonullos/ota-keys"     # *.pem, any one may sign

# where an update may write (relative to /), and what it never may
ALLOWED_V1 = ("usr/local/bin/", "usr/local/sbin/", "usr/local/share/", "usr/local/lib/ztos-sdk/",
              "usr/local/lib/omonullos/", "etc/")
ALLOWED = ALLOWED_V1 + ("usr/local/lib/zboot/", "usr/lib/modules/")
MAX_TRIAL_BOOTS = 2
# tests: the running kernel as these say (release; a plain config file)
UNAME_R = os.environ.get("OMONULLOS_UPDATE_UNAME_R")
KCONFIG = os.environ.get("OMONULLOS_UPDATE_KCONFIG")
NO_MODINFO = os.environ.get("OMONULLOS_UPDATE_NO_MODINFO") == "1"
DENIED = ("usr/local/bin/busybox-zboot", "usr/local/share/omonullos/ota-keys/",
          "etc/shadow", "etc/gshadow", "etc/passwd", "etc/group", "etc/sudoers",
          "etc/polkit-1/", "etc/fstab", "etc/ssh/ssh_host_", "etc/machine-id",
          "etc/modprobe.d/", "etc/omonullos-update.conf")
KEEP_BACKUPS = 2
AFTER_TEXT = {"reboot": " Telefonni qayta yoqing.", "restart-shell": " Telefonni qayta yoqing."}


# ---------------------------------------------------------------- small things

def log(*words):
    line = time.strftime("%Y-%m-%d %H:%M:%S ") + " ".join(str(w) for w in words)
    print(line, file=sys.stderr)
    try:
        with open(LOG, "a") as f:
            f.write(line + "\n")
    except OSError:
        pass


def status(state, **more):
    os.makedirs(RUN, exist_ok=True)
    more["state"] = state
    more["time"] = int(time.time())
    write_json(os.path.join(RUN, "status.json"), more)


def write_json(path, data):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, ensure_ascii=False, indent=1)
        f.flush()
        os.fsync(f.fileno())
    os.replace(tmp, path)


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            h.update(block)
    return h.hexdigest()


def version_key(v):
    out = []
    for part in str(v).lstrip("v").split("."):
        digits = "".join(c for c in part if c.isdigit())
        out.append(int(digits) if digits else 0)
    return tuple(out)


def tell(title, text):
    """A notification for whoever is at the phone (ztMETRO's control FIFO)."""
    if ROOT != "/":
        return
    base = "/run/user"
    try:
        users = os.listdir(base)
    except OSError:
        return
    for u in users:
        ctl = os.path.join(base, u, "ztmetro.ctl")
        try:
            fd = os.open(ctl, os.O_WRONLY | os.O_NONBLOCK)   # no reader: fails, never blocks
        except OSError:
            continue
        try:
            os.write(fd, f"notify Yangilanişlar|{title}|{text}\n".encode())
        except OSError:
            pass
        finally:
            os.close(fd)


def config():
    conf = {"source": "github:urinbayevoff/omonullos-beyondx", "channel": "stable"}
    try:
        with open(CONF) as f:
            for line in f:
                line = line.split("#", 1)[0].strip()
                if "=" in line:
                    k, v = line.split("=", 1)
                    conf[k.strip()] = v.strip()
    except OSError:
        pass
    return conf


def under_root(rel):
    return os.path.join(ROOT, rel) if ROOT != "/" else "/" + rel


# ---------------------------------------------------------------- paths

def check_path(rel):
    """A manifest path is usable only if it is plain, relative and allowed."""
    if not isinstance(rel, str) or not rel or rel.startswith("/") or "\\" in rel or "\0" in rel:
        raise ValueError(f"bad path {rel!r}")
    parts = rel.split("/")
    if any(p in ("", ".", "..") for p in parts):
        raise ValueError(f"bad path {rel!r}")
    if not rel.startswith(ALLOWED):
        raise ValueError(f"not allowed: {rel}")
    for d in DENIED:
        if rel == d.rstrip("/") or rel.startswith(d):
            raise ValueError(f"denied: {rel}")
    if rel.startswith("usr/lib/modules/") and (len(parts) < 6 or parts[4] != "extra"):
        raise ValueError(f"modules only below usr/lib/modules/RELEASE/extra: {rel}")
    if rel.endswith(".ko") and not rel.startswith(("usr/local/lib/zboot/", "usr/lib/modules/")):
        raise ValueError(f"a module outside the module places: {rel}")
    return rel


def kernel_side(rel):
    return rel.endswith(".ko") or rel.startswith("usr/lib/modules/")


def kernel_files(m):
    return [e for e in m["files"] if kernel_side(e["path"])]


CONFIG_SKIP = ("CONFIG_INITRAMFS_SOURCE=", "CONFIG_RUSTC_", "CONFIG_PAHOLE_VERSION=", "CONFIG_BUILD_SALT=",
               "CONFIG_LOCALVERSION=", "CONFIG_OPENSSL_SUPPORTS_")


def config_digest(conf):
    """sha256 of a kernel config's set options, sorted, minus what only says
    where or with which host tools it was built (the CI's paths, rustc,
    pahole, openssl): two builds of the same kernel with the same options
    give the same digest."""
    lines = sorted(line for line in conf.decode(errors="replace").splitlines()
                   if line.startswith("CONFIG_") and "=" in line and not line.startswith(CONFIG_SKIP))
    return hashlib.sha256("\n".join(lines).encode()).hexdigest()


def running_kernel():
    """(release, config_digest of its config)"""
    import gzip
    release = UNAME_R or os.uname().release
    if KCONFIG:
        with open(KCONFIG, "rb") as f:
            conf = f.read()
    else:
        with gzip.open("/proc/config.gz") as f:
            conf = f.read()
    return release, config_digest(conf)


def kernel_mismatch(m):
    """None if the manifest's modules are for the running kernel, else why not."""
    k = m.get("kernel") or {}
    try:
        release, conf = running_kernel()
    except OSError as e:
        return f"cannot read the running kernel's config: {e}"
    if k.get("release") != release:
        return f"for kernel {k.get('release')}, this one is {release}"
    if k.get("config_digest") != conf:
        return "for a kernel built with another config"
    return None


def stage_filter(member, path):
    """tarfile's data filter, but a symlink may point anywhere (v0.2's package
    has /etc/localtime -> /usr/share/zoneinfo/...): links are only compared
    with the manifest and put in place, never followed; a file below a link
    that leaves the stage is still refused (data filter on files)."""
    if member.issym():
        return tarfile.tar_filter(member, path)
    return tarfile.data_filter(member, path)


def check_parent(rel):
    """The same check as safe_parent, creating nothing: done for every file
    before the first one is written."""
    cur = os.path.realpath(ROOT)
    for part in rel.split("/")[:-1]:
        cur = os.path.join(cur, part)
        if os.path.islink(cur):
            raise ValueError(f"symlink on the way: {cur}")
        if not os.path.exists(cur):
            return
        if not os.path.isdir(cur):
            raise ValueError(f"not a directory: {cur}")


def safe_parent(rel):
    """Make the directories for rel; refuse to go through a symlink (an update
    must not be able to write outside the allowed places that way)."""
    real_root = os.path.realpath(ROOT)
    cur = real_root
    for part in rel.split("/")[:-1]:
        cur = os.path.join(cur, part)
        if os.path.islink(cur):
            # the system's own /usr/sbin -> bin style links are not ours to follow
            raise ValueError(f"symlink on the way: {cur}")
        if not os.path.exists(cur):
            os.mkdir(cur, 0o755)
        elif not os.path.isdir(cur):
            raise ValueError(f"not a directory: {cur}")
    return cur


# ---------------------------------------------------------------- the release

def fetch(url, dest=None, limit=64 << 20):
    req = urllib.request.Request(url, headers={"User-Agent": "omonullos-update",
                                               "Accept": "application/octet-stream"})
    with urllib.request.urlopen(req, timeout=60) as r:
        if dest is None:
            data = r.read(limit + 1)
            if len(data) > limit:
                raise ValueError(f"too big: {url}")
            return data
        n = 0
        with open(dest, "wb") as f:
            for block in iter(lambda: r.read(1 << 16), b""):
                n += len(block)
                if n > limit:
                    raise ValueError(f"too big: {url}")
                f.write(block)
        return dest


def releases(conf):
    """[(tag, {asset name: url})] newest first, from the configured source:
    github:OWNER/REPO, or dir:/path (one subdirectory per release, for tests)."""
    src = conf["source"]
    if src.startswith("dir:"):
        base = src[4:]
        out = []
        for tag in sorted(os.listdir(base), reverse=True):
            d = os.path.join(base, tag)
            if os.path.isdir(d):
                out.append((tag, {n: "file://" + os.path.join(d, n) for n in os.listdir(d)}))
        return out
    if src.startswith("github:"):
        repo = src[7:]
        data = json.loads(fetch(f"https://api.github.com/repos/{repo}/releases?per_page=15", limit=4 << 20))
        # drafts are not offered (a release is a draft until the owner signs
        # it); pre-releases are: beyondx is all beta for now
        return [(r["tag_name"], {a["name"]: a["browser_download_url"] for a in r.get("assets", [])})
                for r in data if not r.get("draft")]
    raise ValueError(f"unknown source {src}")


def verify_sig(manifest_path, sig_path):
    """True if any key in KEYS signed these exact bytes."""
    keys_dir = under_root(KEYS.lstrip("/")) if ROOT != "/" else KEYS
    try:
        keys = sorted(k for k in os.listdir(keys_dir) if k.endswith(".pem"))
    except OSError:
        keys = []
    if not keys:
        raise RuntimeError(f"no signing keys in {keys_dir}")
    for k in keys:
        r = subprocess.run(["openssl", "pkeyutl", "-verify", "-pubin", "-inkey", os.path.join(keys_dir, k),
                            "-rawin", "-in", manifest_path, "-sigfile", sig_path],
                           stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
        if r.returncode == 0:
            return k
    return None


def check_manifest(m):
    if not isinstance(m, dict) or m.get("format") != 1:
        raise ValueError("unknown manifest format")
    if m.get("device") != DEVICE:
        raise ValueError(f"for another device: {m.get('device')}")
    for key in ("version", "package", "files"):
        if key not in m:
            raise ValueError(f"manifest has no {key}")
    for pkg in (m["package"], m.get("delta")):
        if pkg is None and m.get("delta") is None:
            continue
        if not isinstance(pkg, dict) or "/" in str(pkg.get("name", "/")) or \
                str(pkg.get("name")) in ("manifest.json", "manifest.json.sig") or len(str(pkg.get("sha256", ""))) != 64:
            raise ValueError("bad package entry")
    for e in m["files"]:
        check_path(e["path"])
        kind = e.get("type", "file")
        if kind == "file" and len(str(e.get("sha256", ""))) != 64:
            raise ValueError(f"no sha256 for {e['path']}")
        if kind == "link" and (not isinstance(e.get("target"), str) or not e["target"] or "\0" in e["target"]):
            raise ValueError(f"bad link {e['path']}")
        if kind not in ("file", "link"):
            raise ValueError(f"unknown entry type {kind}")
    for rel in m.get("remove", []):
        check_path(rel)
    kf = kernel_files(m) + [{"path": r} for r in m.get("remove", []) if kernel_side(r)]
    zb = [e for e in m["files"] if e["path"].startswith("usr/local/lib/zboot/")]
    if kf or zb:
        if int(m.get("min_updater", 1)) < 2:
            raise ValueError("modules or zboot files need min_updater 2")
    if kf:
        k = m.get("kernel")
        if not isinstance(k, dict) or not k.get("release") or not k.get("vermagic") or \
                len(str(k.get("config_digest", ""))) != 64:
            raise ValueError("modules without a kernel (release, vermagic, config_digest)")
        for e in kf:
            p = e["path"].split("/")
            if e["path"].startswith("usr/lib/modules/") and p[3] != k["release"]:
                raise ValueError(f"module for another release: {e['path']}")


def installed():
    return read_json(os.path.join(VAR, "installed.json")) or {"version": "0", "files": []}


def find_update(conf, work):
    """The newest release newer than what is installed whose manifest is signed
    and meant for this phone: (manifest, assets) or (None, why)."""
    have = installed()
    why = "uptodate"
    for tag, assets in sorted(releases(conf), key=lambda r: version_key(r[0].rsplit("-v", 1)[-1]), reverse=True):
        if "manifest.json" not in assets or "manifest.json.sig" not in assets:
            continue
        mp = os.path.join(work, "manifest.json")
        sp = os.path.join(work, "manifest.json.sig")
        fetch(assets["manifest.json"], mp, limit=8 << 20)
        fetch(assets["manifest.json.sig"], sp, limit=4096)
        key = verify_sig(mp, sp)
        if not key:
            log("release", tag, ": signature NOT good, skipped")
            why = "badsig"
            continue
        m = read_json(mp)
        try:
            check_manifest(m)
        except (ValueError, KeyError, TypeError) as e:
            log("release", tag, ": manifest refused:", e)
            why = "refused"
            continue
        if version_key(m["version"]) <= version_key(have.get("version", "0")):
            return None, why
        if int(m.get("min_updater", 1)) > UPDATER_VERSION:
            m["_needs_updater"] = True
        elif kernel_files(m):
            why_not = kernel_mismatch(m)
            if why_not:
                log("release", tag, ": modules not for this kernel:", why_not)
                why = "kernel"
                continue
        m["_tag"] = tag
        m["_key"] = key
        m["_assets"] = assets
        with open(mp, "rb") as f:
            m["_manifest_sha256"] = hashlib.sha256(f.read()).hexdigest()
        return m, "available"
    return None, why


# ---------------------------------------------------------------- commands

def cmd_check(quiet=False):
    status("checking")
    log("== check")
    with tempfile.TemporaryDirectory(prefix="omonullos-update.") as work:
        try:
            m, why = find_update(config(), work)
        except Exception as e:  # network, GitHub, keys
            log("check failed:", repr(e))
            status("failed", msg=f"check: {e}")
            return 1
        avail = os.path.join(VAR, "available.json")
        if m is None:
            if os.path.exists(avail):
                os.remove(avail)
            status(why, version=installed().get("version", "0"))
            log("check:", why)
            return 0
        write_json(avail, m)
        if m.get("_needs_updater"):
            status("needs-updater", version=m["version"])
        else:
            status("available", version=m["version"])
        log("check: available", m["version"], "signed by", m["_key"])
        if not quiet:
            tell("omonullOS " + m["version"], "Yangi versiya bor. Yangilanişlar ilovasini oçing.")
        return 0


def cmd_apply():
    avail = read_json(os.path.join(VAR, "available.json"))
    if not avail:
        status("failed", msg="nothing to install (check first)")
        return 1
    if avail.get("_needs_updater"):
        status("needs-updater", version=avail["version"])
        return 1
    have = installed()
    old_files = {e["path"]: e for e in have.get("files", [])}
    log("== apply", have.get("version"), "->", avail["version"])
    os.makedirs(VAR, exist_ok=True)
    work = tempfile.mkdtemp(prefix="apply.", dir=VAR)
    try:
        # 1. the manifest again, and its signature again: available.json is only
        #    a note for the app, the files are trusted from what is signed now
        status("downloading", version=avail["version"])
        assets = avail["_assets"]
        mp, sp = os.path.join(work, "manifest.json"), os.path.join(work, "manifest.json.sig")
        fetch(assets["manifest.json"], mp, limit=8 << 20)
        fetch(assets["manifest.json.sig"], sp, limit=4096)
        if not verify_sig(mp, sp):
            raise RuntimeError("signature not good")
        m = read_json(mp)
        check_manifest(m)
        if m["version"] != avail["version"]:
            raise RuntimeError("the release changed since the check; check again")
        if int(m.get("min_updater", 1)) > UPDATER_VERSION:
            raise RuntimeError("needs a newer updater")
        if kernel_files(m) and kernel_mismatch(m):
            raise RuntimeError("modules not for this kernel: " + kernel_mismatch(m))

        # 2. the package: the delta from the installed version if there is
        #    one, else the full one; its sha256, then every file in it
        pkg, delta = m["package"], m.get("delta")
        if delta and str(delta.get("base")) == str(have.get("version")) and delta["name"] in assets:
            pkg = delta
        elif pkg["name"] not in assets:
            raise RuntimeError("the release has no " + pkg["name"])
        log("apply: package", pkg["name"], pkg.get("size"), "bytes")
        pp = os.path.join(work, pkg["name"])
        fetch(assets[pkg["name"]], pp, limit=int(pkg.get("size", 512 << 20)) + 1)
        if sha256_file(pp) != pkg["sha256"]:
            raise RuntimeError("package sha256 does not match")
        status("verifying", version=m["version"])
        stage = os.path.join(work, "stage")
        os.mkdir(stage)
        with tarfile.open(pp, "r:*") as t:
            t.extractall(stage, filter=stage_filter)
        need = 0
        todo = []
        for e in m["files"]:
            src = os.path.join(stage, e["path"])
            if not os.path.lexists(src):
                if pkg is m["package"]:
                    raise RuntimeError("the package has no " + e["path"])
                continue  # a delta: unchanged since the base, nothing to do
            if e.get("type", "file") == "link":
                if not os.path.islink(src) or os.readlink(src) != e["target"]:
                    raise RuntimeError("link differs: " + e["path"])
            elif os.path.islink(src) or not os.path.isfile(src) or sha256_file(src) != e["sha256"]:
                raise RuntimeError("file differs from the manifest: " + e["path"])
            else:
                need += os.path.getsize(src)
                if e["path"].endswith(".ko") and not NO_MODINFO:
                    vm = subprocess.run(["modinfo", "-F", "vermagic", src], stdout=subprocess.PIPE,
                                        stderr=subprocess.DEVNULL, text=True).stdout.strip()
                    if vm != m["kernel"]["vermagic"]:
                        raise RuntimeError(f"vermagic of {e['path']}: {vm!r}")
            check_parent(e["path"])   # before anything is written: no symlink on the way
            todo.append(e)
        free = shutil.disk_usage(ROOT).free
        if free < 2 * need + (64 << 20):
            raise RuntimeError(f"not enough space: {free >> 20} MB free, {need >> 20} MB needed")

        # 3. back up and install, one file at a time, each by rename; the
        #    journal is on disk before each change, so a rollback (or the undo
        #    below, if something fails half way) knows exactly what to put back
        bdir = os.path.join(VAR, "backup", str(have.get("version", "0")))
        if os.path.exists(bdir):
            shutil.rmtree(bdir)
        os.makedirs(os.path.join(bdir, "files"))
        write_json(os.path.join(bdir, "from.json"), have)
        journal = {"from_version": have.get("version", "0"), "to_version": m["version"], "replaced": [],
                   "created": [], "kept": [], "removed": [], "done": False, "time": int(time.time()),
                   "after": m.get("after", "reboot")}
        jpath = os.path.join(bdir, "journal.json")
        write_json(jpath, journal)
        try:
            n = len(todo)
            for k, e in enumerate(todo, 1):
                status("installing", version=m["version"], k=k, n=n, name=e["path"].rsplit("/", 1)[-1])
                install_one(e, stage, bdir, old_files.get(e["path"]), journal, jpath)
            for rel in m.get("remove", []):
                remove_one(rel, bdir, old_files.get(rel), journal, jpath)
            os.sync()
            new = {k: v for k, v in m.items() if not k.startswith("_")}
            new["installed_at"] = int(time.time())
            write_json(os.path.join(VAR, "installed.json"), new)
            journal["done"] = True
            write_json(jpath, journal)
            changed = journal["replaced"] + journal["created"] + journal["removed"]
            if any(kernel_side(r) for r in changed):
                # the next boots are a trial (cmd_boot); the modules' index
                write_json(os.path.join(VAR, "trial.json"), {"version": m["version"], "boots": 0,
                                                            "time": int(time.time())})
                if ROOT == "/" and any(r.startswith("usr/lib/modules/") for r in changed):
                    subprocess.run(["depmod", "-a", m["kernel"]["release"]], check=False)
                log("apply: modules changed, the next boots are a trial")
        except Exception:
            log("apply: failed half way, putting back what was changed")
            undo(bdir, journal)
            raise
        try:
            os.remove(os.path.join(VAR, "available.json"))
        except OSError:
            pass
        prune_backups(keep=str(have.get("version", "0")))
        status("done", version=m["version"], after=m.get("after", "reboot"), kept=journal["kept"])
        log("apply: done", m["version"], "replaced", len(journal["replaced"]), "created",
            len(journal["created"]), "kept (yours, .new written)", journal["kept"])
        tell("omonullOS " + m["version"], "Örnatildi." + AFTER_TEXT.get(m.get("after", "reboot"), ""))
        return 0
    except Exception as e:
        log("apply failed:", repr(e))
        status("failed", msg=str(e))
        tell("Yangilanmadi", str(e)[:120])
        return 1
    finally:
        shutil.rmtree(work, ignore_errors=True)


def backup(rel, bdir):
    dst = os.path.join(bdir, "files", rel)
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    src = under_root(rel)
    if os.path.islink(src):
        os.symlink(os.readlink(src), dst)
    else:
        shutil.copy2(src, dst)


def put(src, dest, mode):
    """Copy src to dest by a temp file in the same directory and a rename: a
    running program keeps its old file, nothing is ever half written."""
    tmp = dest + ".omonullos-new"
    if os.path.lexists(tmp):
        os.remove(tmp)
    with open(src, "rb") as fi, open(tmp, "wb") as fo:
        shutil.copyfileobj(fi, fo, 1 << 20)
        os.fchmod(fo.fileno(), mode)
        fo.flush()
        os.fsync(fo.fileno())
    os.replace(tmp, dest)


def note(journal, jpath, what, rel):
    journal[what].append(rel)
    write_json(jpath, journal)


def put_link(target, dest):
    tmp = dest + ".omonullos-new"
    if os.path.lexists(tmp):
        os.remove(tmp)
    os.symlink(target, tmp)
    os.replace(tmp, dest)


def install_one(e, stage, bdir, old, journal, jpath):
    rel = check_path(e["path"])
    safe_parent(rel)
    dest = under_root(rel)
    src = os.path.join(stage, rel)
    exists = os.path.lexists(dest)
    if exists and os.path.isdir(dest) and not os.path.islink(dest):
        raise RuntimeError("a directory is in the way: " + rel)
    if e.get("type", "file") == "link":
        if exists and os.path.islink(dest) and os.readlink(dest) == e["target"]:
            return
        if exists:
            backup(rel, bdir)
        note(journal, jpath, "replaced" if exists else "created", rel)
        put_link(e["target"], dest)
        return
    mode = int(str(e.get("mode", "644")), 8) & 0o7777
    cur = sha256_file(dest) if exists and not os.path.islink(dest) else None
    if cur == e["sha256"]:
        if (os.stat(dest).st_mode & 0o7777) != mode:
            os.chmod(dest, mode)
        return
    if exists and rel.startswith("etc/"):
        # a configuration file: replace it only if it is still ours (what the
        # last update put there); if the owner changed it, leave theirs alone
        if old is None or cur != old.get("sha256"):
            put(src, dest + ".new", mode)
            note(journal, jpath, "kept", rel)
            return
    if exists:
        backup(rel, bdir)
    note(journal, jpath, "replaced" if exists else "created", rel)
    put(src, dest, mode)


def remove_one(rel, bdir, old, journal, jpath):
    dest = under_root(rel)
    if not os.path.lexists(dest) or os.path.isdir(dest) and not os.path.islink(dest):
        return
    if old is None or os.path.islink(dest) or sha256_file(dest) != old.get("sha256"):
        return  # not what we put there: leave it
    backup(rel, bdir)
    note(journal, jpath, "removed", rel)
    os.remove(dest)


def undo(bdir, j):
    """Put back what journal j changed (newest first). Each step is checked
    against the backup, so running it twice (a rollback after a power cut in
    the middle of one) does no harm."""
    steps = [("back", r) for r in j["replaced"] + j["removed"]] + [("drop", r) for r in j["created"]]
    for k, (what, rel) in enumerate(steps, 1):
        status("rolling-back", k=k, n=len(steps), name=rel.rsplit("/", 1)[-1])
        check_path(rel)
        dest = under_root(rel)
        if what == "back":
            src = os.path.join(bdir, "files", rel)
            if not os.path.lexists(src):
                continue  # noted, then failed before the backup was even made
            safe_parent(rel)
            if os.path.islink(src):
                put_link(os.readlink(src), dest)
            else:
                put(src, dest, os.stat(src).st_mode & 0o7777)
        elif os.path.lexists(dest) and not (os.path.isdir(dest) and not os.path.islink(dest)):
            os.remove(dest)
    for rel in j["kept"]:
        try:
            os.remove(under_root(rel) + ".new")
        except OSError:
            pass
    os.sync()
    prev = read_json(os.path.join(bdir, "from.json"))
    if prev is not None:
        write_json(os.path.join(VAR, "installed.json"), prev)


def prune_backups(keep):
    base = os.path.join(VAR, "backup")
    try:
        dirs = sorted(os.listdir(base), key=lambda d: os.path.getmtime(os.path.join(base, d)), reverse=True)
    except OSError:
        return
    for d in dirs[KEEP_BACKUPS:]:
        if d != keep:
            shutil.rmtree(os.path.join(base, d), ignore_errors=True)


def last_backup():
    """The backup of the update now installed: finished, or cut short (power
    lost in the middle of an apply: then it is what a rollback must undo)."""
    base = os.path.join(VAR, "backup")
    now = str(installed().get("version", "0"))
    best = None
    try:
        for d in os.listdir(base):
            j = read_json(os.path.join(base, d, "journal.json"))
            if not j:
                continue
            if (j.get("done") and str(j.get("to_version")) == now) or \
                    (not j.get("done") and str(j.get("from_version")) == now):
                if best is None or j["time"] > best[1]["time"]:
                    best = (os.path.join(base, d), j)
    except OSError:
        pass
    return best


def cmd_rollback():
    b = last_backup()
    if not b:
        status("failed", msg="nothing to roll back")
        return 1
    bdir, j = b
    log("== rollback", j["to_version"], "->", j["from_version"], "" if j.get("done") else "(unfinished apply)")
    try:
        undo(bdir, j)
        shutil.rmtree(bdir, ignore_errors=True)
        try:
            os.remove(os.path.join(VAR, "trial.json"))
        except OSError:
            pass
        status("rolled-back", version=j["from_version"], after=j.get("after", "reboot"))
        log("rollback: done, now", j["from_version"])
        tell("omonullOS " + str(j["from_version"]),
             "Oldingi versiyaga qaytildi." + AFTER_TEXT.get(j.get("after", "reboot"), ""))
        return 0
    except Exception as e:
        log("rollback failed:", repr(e))
        status("failed", msg="rollback: " + str(e))
        return 1


def cmd_boot():
    """Early at boot, before our modules load. Never fails the boot."""
    tpath = os.path.join(VAR, "trial.json")
    t = read_json(tpath)
    if not t:
        return 0
    t["boots"] = int(t.get("boots", 0)) + 1
    write_json(tpath, t)
    os.sync()
    log("boot: trial of", t.get("version"), "boot", t["boots"])
    if t["boots"] <= MAX_TRIAL_BOOTS:
        return 0
    log("boot: the phone did not stay up after", t.get("version"), "- putting the old files back")
    b = last_backup()
    if b and str(b[1].get("to_version")) == str(t.get("version")):
        cmd_rollback()
        status("rolled-back", version=b[1]["from_version"], after="none", auto=True)
    else:
        log("boot: no backup for", t.get("version"))
    try:
        os.remove(tpath)
    except OSError:
        pass
    return 0


def cmd_boot_ok():
    tpath = os.path.join(VAR, "trial.json")
    if os.path.exists(tpath):
        os.remove(tpath)
        log("boot-ok: the trial passed")
    return 0


def cmd_status():
    have = installed()
    print("installed:", have.get("version"), have.get("_tag", have.get("tag", "")))
    s = read_json(os.path.join(RUN, "status.json"))
    print("status:", json.dumps(s, ensure_ascii=False) if s else "idle")
    a = read_json(os.path.join(VAR, "available.json"))
    if a:
        print("available:", a["version"], "(" + a.get("_tag", "") + ")")
    b = last_backup()
    print("rollback to:", b[1]["from_version"] if b else "-")
    t = read_json(os.path.join(VAR, "trial.json"))
    if t:
        print("trial:", t.get("version"), "boots", t.get("boots"))
    return 0


def main(argv):
    if not argv or argv[0] not in ("check", "apply", "rollback", "status", "boot", "boot-ok"):
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        return 2
    if argv[0] == "status":
        return cmd_status()
    if ROOT == "/" and os.geteuid() != 0:
        print("omonullos-update: run as root (the Updates app starts its services)", file=sys.stderr)
        return 1
    os.makedirs(RUN, exist_ok=True)
    os.makedirs(VAR, exist_ok=True)
    import fcntl
    lock = open(os.path.join(RUN, "lock"), "w")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        print("omonullos-update: already running", file=sys.stderr)
        return 1
    os.umask(0o022)
    if argv[0] == "check":
        return cmd_check(quiet="--quiet" in argv)
    if argv[0] == "apply":
        return cmd_apply()
    if argv[0] == "boot":
        return cmd_boot()
    if argv[0] == "boot-ok":
        return cmd_boot_ok()
    return cmd_rollback()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

# zcall-uplink.sh reads this at every call (/etc/zcall-once.env, one call, wins)
# the downlink: RDMA4 (the VSS RX) through SPUS stream 4 and ASRC4, 32 -> 48 kHz
ZCALL_RDMA4=1
ZCALL_ASRC=1
# the uplink: NSRC0/NSRC1 rate converters on (SPUM_CTRL0 bits 4/8), so WDMA2
# fills at the VSS's 10 ms; without them the VSS restarted WDMA2/WDMA3 every
# frame and the call was choppy (log.md 10.11 14:20: clear call)
ZCALL_NSRC_ASRC=1

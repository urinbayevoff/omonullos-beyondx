# Galaxy S10 5G (OmonullOS, October 2026): wlroots renders with Panfrost
# (zgpu.service loads it before greetd) and shows the frames on the
# bootloader framebuffer (simpledrm) until a DECON driver is in. Software
# rendering (llvmpipe) stays allowed as the fallback when Panfrost is not
# there. ztMETRO reads the touchscreen itself: no libinput devices.
export WLR_RENDERER_ALLOW_SOFTWARE=1
export WLR_LIBINPUT_NO_DEVICES=1
# The dual front camera's hole at the top right, in panel pixels (LineageOS
# beyondx config_mainBuiltInDisplayCutout: M 0,0 H -427 V 139 H 0 V 0 Z @right)
export ZTMETRO_CUTOUT=427x139@right
# the camera hole itself inside that box, X Y W H in pixels, less 4 px a side
# (measured 19.11.2026 off photos of a ruler drawn there: x 1018-1336, y 40-140);
# ztMETRO draws the app-in-front pill there (screenshots only)
export ZTMETRO_CUTOUT_HOLE="1022 44 310 92"

# Galaxy S10 5G: both modems and the RIL at boot (zmodem start: zprops,
# rild-lite, the 5G and the LTE modem's cbd, zsms, zcell), so the SIM,
# signal, SMS and calls come up with the phone. ~150 s later `zmodem check`
# tells the owner on screen if the phone did not register: the S5100 at
# times does not come up, and a second start needs a power cycle.
# Added for OmonullOS, October 2026.
[Unit]
Description=zboot (Galaxy S10 5G): modems and RIL
After=local-fs.target zclock.service zcpu.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/zmodem start
ExecStartPost=/usr/bin/systemd-run -q --unit=zmodem-check --collect --on-active=150 /usr/local/bin/zmodem check
ExecStop=/bin/sh -c 'systemctl stop zcell zsms zril; /usr/local/bin/zmodem down'
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
